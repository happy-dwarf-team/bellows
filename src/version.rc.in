// Version resource of bellows.dll; configured by CMake from version.txt.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Happy Dwarf Team"
            VALUE "FileDescription", "Bellows: faster EU4 start-up (Anvil plugin)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "bellows"
            VALUE "LegalCopyright", "Copyright (c) 2026 Happy Dwarf Team. MIT License."
            VALUE "OriginalFilename", "bellows.dll"
            VALUE "ProductName", "Bellows"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "Comments", "Unofficial community project, not affiliated with Paradox Interactive. https://github.com/happy-dwarf-team/bellows"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
